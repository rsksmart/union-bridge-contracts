RSK_TESTNET_RPC=https://public-node.testnet.rsk.co
RSK_MAINNET_RPC=https://public-node.rsk.co
RSK_ALPHANET_RPC=http://node-use1-1.alphanet.rskcomputing.net:4444
RSK_REGTEST_RPC=http://localhost:4444
LOCAL_RPC=http://localhost:8545 #http://host.docker.internal:8545
MNEMONIC="test test test test test test test test test test test junk"
DEPLOYER_INDEX=0
MAX_MNEMONIC_INDEX=9

# Network selection (default: local, overridden by shell scripts with --alphanet/--testnet/--mainnet flags)
NETWORK=local

# Local/Regtest Contract Addresses (Anvil - deterministic)
LOCAL_PEGIN_MANAGER=0x9A9f2CCfdE556A7E9Ff0848998Aa4a0CFD8863AE

# RSK Regtest Contract Addresses
REGTEST_PEGIN_MANAGER=

# Alphanet Contract Addresses (to be filled after deployment)
ALPHANET_PEGIN_MANAGER=

# Testnet Contract Addresses (to be filled after deployment)
TESTNET_PEGIN_MANAGER=

# Mainnet Contract Addresses (to be filled after deployment)
MAINNET_PEGIN_MANAGER=

# Blockscout API endpoints for contract verification
# Used by forge verify-contract with --verifier blockscout
BLOCKSCOUT_TESTNET_API=https://rootstock-testnet.blockscout.com/api
BLOCKSCOUT_MAINNET_API=https://rootstock.blockscout.com/api

# RSK Explorer API endpoints for contract verifications
# Used by forge verify-contract with --verifier custom
RSK_EXPLORER_ALPHANET_API=
RSK_EXPLORER_TESTNET_API=https://be.explorer.testnet.rootstock.io/api/v3/etherscan
RSK_EXPLORER_MAINNET_API=https://be.explorer.rootstock.io/api/v3/etherscan

# RSK Explorer base URLs for viewing verified contracts
# Used for displaying verification status links
RSK_EXPLORER_ALPHANET=
RSK_EXPLORER_TESTNET_URL=https://explorer.testnet.rootstock.io
RSK_EXPLORER_MAINNET_URL=https://explorer.rsk.co

# Gas price for contract deployments
GAS_PRICE_IN_WEIS=26000000
